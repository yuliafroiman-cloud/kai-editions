NEXT_PUBLIC_KAI_CHAT_URL=https://yuliafroiman.app.n8n.cloud/webhook/e7e46c7f-9c7b-455a-b025-edbac31fed0e/chat

# --- טופס "צרו קשר" (אופציונלי) ---
